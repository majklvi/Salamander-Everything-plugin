#include <windows.h>
#include "settings_resource.h"

IDI_CHECKING ICON "checking.ico"
IDI_UNAVAILABLE ICON "unavailable.ico"

IDD_SEARCH_SETTINGS DIALOGEX 0, 0, 233, 251
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Everything Search Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Everything source", -1, 8, 8, 75, 10
    COMBOBOX        IDC_SOURCE, 86, 5, 140, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Result columns", -1, 8, 22, 55, 8, WS_GROUP
    CONTROL         "", IDC_COLUMNS_RULE, "Static", SS_ETCHEDHORZ | WS_GROUP, 65, 26, 161, 1
    AUTOCHECKBOX    "&Size", IDC_FILE_SIZE, 15, 33, 91, 10
    AUTOCHECKBOX    "&Parent folder", IDC_PARENT_FOLDER, 15, 44, 91, 10
    AUTOCHECKBOX    "&Extension", IDC_EXTENSION, 15, 55, 91, 10
    AUTOCHECKBOX    "Date &modified", IDC_MODIFIED, 15, 66, 91, 10
    AUTOCHECKBOX    "Date &created", IDC_CREATED, 15, 77, 91, 10
    AUTOCHECKBOX    "Date &accessed", IDC_ACCESSED, 15, 88, 91, 10
    AUTOCHECKBOX    "Attri&butes", IDC_ATTRIBUTES, 112, 33, 110, 10
    AUTOCHECKBOX    "&Run count", IDC_RUN_COUNT, 112, 44, 110, 10
    AUTOCHECKBOX    "Date r&un", IDC_DATE_RUN, 112, 55, 110, 10
    AUTOCHECKBOX    "Date recentl&y changed", IDC_RECENTLY_CHANGED, 112, 66, 110, 10
    AUTOCHECKBOX    "File &list", IDC_FILE_LIST, 112, 77, 110, 10
    LTEXT           "Search results", -1, 8, 101, 52, 8, WS_GROUP
    CONTROL         "", IDC_SEARCH_RULE, "Static", SS_ETCHEDHORZ | WS_GROUP, 62, 105, 164, 1
    LTEXT           "Current search &order", IDC_ORDER_LABEL, 8, 115, 77, 12
    COMBOBOX        IDC_ORDER, 86, 112, 140, 165, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Descending", IDC_DESCENDING, 86, 127, 128, 10
    LTEXT           "Maximum res&ults", -1, 8, 143, 77, 10
    EDITTEXT        IDC_RESULT_LIMIT, 86, 140, 46, 14, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "Default", IDC_DEFAULT_LIMIT, 135, 140, 32, 14
    LTEXT           "0 = unlimited", -1, 170, 143, 42, 10
    RTEXT           "hints", IDC_LIMIT_HINT, 213, 143, 15, 8, WS_TABSTOP
    AUTOCHECKBOX    "Shorten long names and parent folders", IDC_SHORTEN_LABELS, 15, 156, 211, 10
    LTEXT           "Availability", -1, 8, 170, 44, 8, WS_GROUP
    CONTROL         "", IDC_AVAILABILITY_RULE, "Static", SS_ETCHEDHORZ | WS_GROUP, 54, 174, 172, 1
    AUTOCHECKBOX    "Check availability and mark unavailable items", IDC_CHECK_AVAILABILITY, 15, 181, 211, 10
    AUTOCHECKBOX    "Hide unavailable items from results", IDC_HIDE_UNAVAILABLE, 23, 192, 203, 10
    LTEXT           "Network retry delay (seconds)", -1, 15, 207, 113, 10
    EDITTEXT        IDC_NETWORK_RETRY, 132, 204, 37, 14, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "Ad&vanced...", IDC_ADVANCED, 8, 231, 50, 14
    PUSHBUTTON      "&Help", IDHELP, 64, 231, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 120, 231, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 176, 231, 50, 14
END

IDD_ADVANCED DIALOGEX 0, 0, 249, 213
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced Properties"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Filter properties", -1, 8, 10, 65, 11
    EDITTEXT        IDC_PROPERTY_FILTER, 78, 7, 163, 14, ES_AUTOHSCROLL
    LISTBOX         IDC_PROPERTIES, 8, 25, 233, 131, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "&Show as result column", IDC_SHOW_PROPERTY, 8, 164, 128, 12
    PUSHBUTTON      "Use for &sorting", IDC_SORT_PROPERTY, 156, 162, 85, 15
    PUSHBUTTON      "&Help", IDHELP, 8, 190, 50, 15
    DEFPUSHBUTTON   "OK", IDOK, 135, 190, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 190, 50, 15
END
